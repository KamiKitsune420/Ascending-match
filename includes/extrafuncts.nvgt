string menu_hint()
{
    if (is_touch_platform())
        return "Swipe up or down to move, and double tap to select.";
    return "Use your navigation keys to move, and press enter to select.";
}

bool is_beneficial_swap(int pos1, int pos2)
{
    // Create a sorted copy to compare against
    double[] sorted_nums;
    for (uint i = 0; i < nums.length(); i++) {
        sorted_nums.insert_last(nums[i]);
    }
    if (reverse_level) {
        sorted_nums.sort_descending();
    } else {
        sorted_nums.sort_ascending();
    }
    
    // Check how many positions are correct before the swap
    int correct_before = 0;
    for (uint i = 0; i < nums.length(); i++) {
        if (nums[i] == sorted_nums[i]) {
            correct_before++;
        }
    }
    
    // Simulate the swap
    double temp = nums[pos1];
    nums[pos1] = nums[pos2];
    nums[pos2] = temp;
    
    // Check how many positions are correct after the swap
    int correct_after = 0;
    for (uint i = 0; i < nums.length(); i++) {
        if (nums[i] == sorted_nums[i]) {
            correct_after++;
        }
    }
    
    // Restore original order
    temp = nums[pos1];
    nums[pos1] = nums[pos2];
    nums[pos2] = temp;
    
    // Return true if the swap increases the number of correct positions
    return correct_after > correct_before;
}

double generate_number_for_round(int round)
{
    // Calculate shrinking range within each difficulty tier
    int range_reduction = 0;
    
    if (round < 8) {
        // Rounds 1-7: Simple integers with shrinking range
        // Start at 1-99, shrink by 10 each round: 99, 89, 79, 69, 59, 49, 39
        range_reduction = (round - 1) * 10;
        int max_range = (99 - range_reduction) < 39 ? 39 : (99 - range_reduction); // Don't go below 39
        return double(random(1, max_range));
    } else if (round < 12) {
        // Rounds 8-11: Decimal numbers, reset range then shrink
        // Reset to full range at 8, then shrink: 99, 89, 79, 69
        range_reduction = (round - 8) * 10;
        int max_range = (99 - range_reduction) < 69 ? 69 : (99 - range_reduction);
        int whole = random(1, max_range);
        int decimal = random(1, 9);
        return double(whole) + (double(decimal) / 10.0);
    } else if (round < 15) {
        // Rounds 12-14: Negative/positive integers, reset range then shrink
        // Reset to full range, then shrink: 99, 89, 79
        range_reduction = (round - 12) * 10;
        int max_range = (99 - range_reduction) < 79 ? 79 : (99 - range_reduction);
        int num = random(1, max_range);
        // Only apply negative to non-zero numbers
        return (num == 0 || !random_bool()) ? double(num) : double(-num);
    } else if (round < 20) {
        // Rounds 15-19: Larger range with negatives, reset then shrink
        // Start at 1-999, shrink by 100 each round: 999, 899, 799, 699, 599
        range_reduction = (round - 15) * 100;
        int max_range = (999 - range_reduction) < 599 ? 599 : (999 - range_reduction);
        int num = random(1, max_range);
        // Only apply negative to non-zero numbers
        return (num == 0 || !random_bool()) ? double(num) : double(-num);
    } else if (round < 25) {
        // Rounds 20-24: Mix of integers/decimals/negatives, reset then shrink
        // Reset to 1-999, shrink by 100: 999, 899, 799, 699, 599
        range_reduction = (round - 20) * 100;
        int max_range = (999 - range_reduction) < 599 ? 599 : (999 - range_reduction);
        
        int type_choice = random(1, 4); // Add fractions as 4th option
        if (type_choice == 1) {
            // Integer
            int num = random(1, max_range);
            // Only apply negative to non-zero numbers
            return (num == 0 || !random_bool()) ? double(num) : double(-num);
        } else if (type_choice == 2) {
            // Decimal
            int whole = random(1, max_range);
            int decimal = random(1, 9);
            double result = double(whole) + (double(decimal) / 10.0);
            // Only apply negative to non-zero numbers
            return (result < 0.05 || !random_bool()) ? result : -result;
        } else {
            // Fraction (represented as decimal for sorting purposes)
            int numerator = random(1, 20);
            int denominator = random(2, 12);
            double result = double(numerator) / double(denominator);
            // Only apply negative to very small numbers (avoid negative zero and tiny fractions)
            return (result < 0.05 || !random_bool()) ? result : -result;
        }
    } else {
        // Round 25+: Mix of precision decimals and fractions, reset then shrink
        // Start at 1-50, shrink by 5: 50, 45, 40, 35, 30 (minimum 30)
        range_reduction = (round - 25) * 5;
        int max_base = (50 - range_reduction) < 30 ? 30 : (50 - range_reduction);
        
        if (random(1, 3) <= 2) {
            // Precision decimals (66% chance)
            int base = random(1, max_base);
            int decimal = random(1, 99);
            double result = double(base) + (double(decimal) / 100.0);
            // Only apply negative to non-zero numbers
            return (result < 0.05 || !random_bool()) ? result : -result;
        } else {
            // Complex fractions (33% chance)
            int numerator = random(1, max_base);
            int denominator = random(2, 20);
            double result = double(numerator) / double(denominator);
            // Only apply negative to very small numbers (avoid negative zero and tiny fractions)
            return (result < 0.05 || !random_bool()) ? result : -result;
        }
    }
}

string format_number_for_speech(double num)
{
    if (num == floor(num)) {
        // It's a whole number
        return "" + int(num);
    } else {
        // It's a decimal - format with appropriate precision
        return format_float(num, "", 0, 2);
    }
}

string audio_name_entry()
{
    sctext("High score achieved! Time to enter your name.", 40, "dlgopn.ogg", "gamevoice.ogg");

    if (is_touch_platform()) {
        string name = input_box("High Score!", "Enter your name:", "");
        if (name.length() == 0) {
            speak("Using Anonymous.");
            return "Anonymous";
        }
        speak("Name confirmed: " + name);
        return name;
    }

    audio_form f;
    f.create_window("High Score!");
    int name_input = f.create_input_box("Enter your name:", "", "", 20);
    int ok_button = f.create_button("OK", true);
    int cancel_button = f.create_button("Cancel", false, true);

    f.focus(name_input);

    while (true) {
        wait(5);
        f.monitor();

        if (f.is_pressed(ok_button)) {
            string name = f.get_text(name_input);
            if (name.length() > 0) {
                speak("Name confirmed: " + name);
                return name;
            } else {
                speak("Please enter at least one character.");
                f.focus(name_input);
            }
        }

        if (f.is_pressed(cancel_button)) {
            speak("Name entry cancelled. Using Anonymous.");
            return "Anonymous";
        }
    }

    return "Anonymous";
}

void play_curmove_sound()
{
if (stereo_positioning && nums.length() > 1)
{
float pan = -100.0 + (200.0 * numker / (nums.length() - 1));
p.play_stationary_extended("curmove.ogg", false, 0, pan, 0.0, 100.0);
}
else
{
p.play_stationary("curmove.ogg", false);
}
}

void play_edge_sound()
{
if (stereo_positioning && nums.length() > 1)
{
float pan = -100.0 + (200.0 * numker / (nums.length() - 1));
p.play_stationary_extended("curedge.ogg", false, 0, pan, 0.0, 100.0);
}
else
{
p.play_stationary("curedge.ogg", false);
}
}

void check_round_achievements()
{
    if (gameround == 2) {
        ach.award("First Steps");
    } else if (gameround == 5) {
        ach.award("Getting Warmed Up");
    } else if (gameround == 8) {
        ach.award("Decimal Master");
    } else if (gameround == 10) {
        ach.award("Double Digits");
    } else if (gameround == 12) {
        ach.award("Negative Nancy");
    } else if (gameround == 16) {
        ach.award("Lucky Fifteen");
        if (!time_race_unlocked) {
            time_race_unlocked = true;
            writedata();
            ach.award("Ready to Race");
            sctext("New feature unlocked: Time Race mode! You can now compete against the computer in fast-paced sorting challenges.", 40, "dlgopn.ogg", "gamevoice.ogg");
        }
    } else if (gameround == 20) {
        ach.award("The Twenties Club");
    } else if (gameround == 25) {
        ach.award("Precision Expert");
    } else if (gameround == 30) {
        ach.award("Sorting Legend");
    } else if (gameround == 35) {
        ach.award("Rule 34");
    } else if (gameround == 43) {
        ach.award("The Answer");
    } else if (gameround == 50) {
        ach.award("The Ultimate Sorter");
    } else if (gameround == 68) {
        ach.award("Six Seven!!!");
    } else if (gameround == 70) {
        ach.award("NICE!!!");
    } else if (gameround == 100) {
        ach.award("sooooo... board...");
    } else if (gameround == 421) {
        ach.award("420 Blaze It");
    }

    // Time bonus achievements
    if (time_bonus_total >= 100) {
        ach.award("Speedy Sorter");
    }
    if (time_bonus_total >= 500) {
        ach.award("Lightning Fast");
    }
    if (time_bonus_total >= 1000) {
        ach.award("Time Master");
    }

    // Fraction milestone
    if (gameround == 20) {
        ach.award("Fraction Pioneer");
    }
}

void handle_game_over()
{
    double accuracy = 0.0;
    if (total_swaps > 0) {
        accuracy = (double(correct_swaps) / double(total_swaps)) * 100.0;
    }
    
    string stats = "Game Statistics: Round reached " + gameround + ", Total swaps " + total_swaps + ", Correct swaps " + correct_swaps + ", Accuracy " + format_float(accuracy, "", 0, 1) + " percent";
    if (time_bonus_total > 0) {
        stats += ", Time bonus points " + time_bonus_total;
    }
    stats += ".";
    
    sctext(stats, 40, "dlgopn.ogg", "gamevoice.ogg");
    
    // Check for accuracy achievements
    if (total_swaps > 0) {
        if (accuracy >= 90.0) {
            ach.award("Precision Player");
        } else if (accuracy >= 75.0) {
            ach.award("Accurate Sorter");
        } else if (accuracy >= 50.0) {
            ach.award("Getting Better");
        } else if (accuracy == 0.0) {
            ach.award("Master of Chaos");
        }

        if (total_swaps >= 100) {
            ach.award("Swap Master");
        }
        if (total_swaps >= 500) {
            ach.award("Swap Maniac");
        }
    } else if (total_swaps == 0) {
        ach.award("The Great Contemplator");
    }

    // Check for hint achievements
    if (hints_used == 0 && total_swaps > 0) {
        ach.award("The Independent Thinker");
    } else if (hints_used > 5) {
        ach.award("The Hint Addict");
    }
    
    // Record game completion statistics
    // stats.record_game_completion(gameround - 1, accuracy, time_bonus_total, gameround);
    
    // Check if this is a high score
    if (cb.is_high_score(gameround, accuracy, time_bonus_total) && total_swaps > 0) {
        string player_name = audio_name_entry();
        
        if (player_name != "") {
            string game_mode = time_race_mode ? "Time Race" : "Normal";
            cb.add_localscore(player_name, gameround, total_swaps, correct_swaps, time_bonus_total, game_mode);
            sctext("Your score has been saved to the leaderboard!", 30, "dlgopn.ogg", "gamevoice.ogg");
        }
    } else {
        sctext("Thanks for playing! Try again to beat the high scores.", 30, "dlgopn.ogg", "gamevoice.ogg");
    }
}

void computer_ai_step()
{
    // Smarter AI that looks for good swaps
    if (ai_delay == 0) {
        ai_delay = random(1000, 2000); // Initialize delay first time
    }
    
    if (ai_timer.elapsed >= ai_delay) {
        // Find a good swap by looking for out-of-place numbers
        double[] sorted_nums;
        for (uint i = 0; i < computer_nums.length(); i++) {
            sorted_nums.insert_last(computer_nums[i]);
        }
        sorted_nums.sort_ascending();
        
        int pos1 = -1, pos2 = -1;
        
        // Look for numbers that are in wrong positions
        for (uint i = 0; i < computer_nums.length() && pos1 == -1; i++) {
            if (computer_nums[i] != sorted_nums[i]) {
                pos1 = i;
                // Find where this number should go
                for (uint j = 0; j < computer_nums.length(); j++) {
                    if (computer_nums[j] == sorted_nums[i] && i != j) {
                        pos2 = j;
                        break;
                    }
                }
            }
        }
        
        // If we couldn't find a perfect swap, or randomly make a mistake (30% chance)
        if (pos1 == -1 || pos2 == -1 || random(1, 100) <= 30) {
            pos1 = random(0, computer_nums.length() - 1);
            pos2 = random(0, computer_nums.length() - 1);
        }
        
        if (pos1 != pos2) {
            // Make the swap
            double temp = computer_nums[pos1];
            computer_nums[pos1] = computer_nums[pos2];
            computer_nums[pos2] = temp;
            
            computer_swaps++;
            
            // Check if this swap actually improved things
            int correct_after = 0;
            for (uint i = 0; i < computer_nums.length(); i++) {
                if (computer_nums[i] == sorted_nums[i]) {
                    correct_after++;
                }
            }
            
            // Sometimes the AI makes mistakes (70% accuracy target)
            if (random(1, 100) <= 70) {
                computer_correct_swaps++;
            }
            
            // Check if computer has completed the sort
            double[] check_sorted;
            for (uint i = 0; i < computer_nums.length(); i++) {
                check_sorted.insert_last(computer_nums[i]);
            }
            check_sorted.sort_ascending();
            
            bool computer_done = true;
            for (uint i = 0; i < computer_nums.length(); i++) {
                if (computer_nums[i] != check_sorted[i]) {
                    computer_done = false;
                    break;
                }
            }
            
            if (computer_done) {
                computer_finished = true;
            } else {
                // Check computer progress and announce milestones
                double[] sorted_nums;
                for (uint i = 0; i < computer_nums.length(); i++) {
                    sorted_nums.insert_last(computer_nums[i]);
                }
                sorted_nums.sort_ascending();
                
                int correct_positions = 0;
                for (uint i = 0; i < computer_nums.length(); i++) {
                    if (computer_nums[i] == sorted_nums[i]) {
                        correct_positions++;
                    }
                }
                
                double progress_percent = (double(correct_positions) / double(computer_nums.length())) * 100.0;
                
                // Announce progress milestones
                if (progress_percent >= 20.0 && !computer_progress_announced[0]) {
                    p.play_stationary("wrn.ogg", false);
                    speak("Alert! The computer is 20 percent done, watch out!");
                    computer_progress_announced[0] = true;
                } else if (progress_percent >= 40.0 && !computer_progress_announced[1]) {
                    p.play_stationary("wrn.ogg", false);
                    speak("Alert! The computer is 40 percent done, watch out!");
                    computer_progress_announced[1] = true;
                } else if (progress_percent >= 60.0 && !computer_progress_announced[2]) {
                    p.play_stationary("wrn.ogg", false);
                    speak("Alert! The computer is 60 percent done, watch out!");
                    computer_progress_announced[2] = true;
                } else if (progress_percent >= 80.0 && !computer_progress_announced[3]) {
                    p.play_stationary("wrn.ogg", false);
                    speak("Alert! The computer is 80 percent done, watch out!");
                    computer_progress_announced[3] = true;
                }
            }
        }
        
        ai_timer.restart();
        ai_delay = random(4000, 7000); // Next swap in 4-7 seconds (slower pace)
    }
}

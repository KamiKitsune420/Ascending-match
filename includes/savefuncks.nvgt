void readdata()
{
sd.load();
if (sd.d.exists("menumusvolume"))
{
menumusvolume = sd.read_int("menumusvolume");
}
if (sd.d.exists("use_sr"))
{
use_sr = sd.read_bool("use_sr");
}
if (sd.d.exists("tts_config"))
{
string tts_config_str = sd.read_string("tts_config");
tts_load_config(tts_config_str, tts);
}
if (sd.d.exists("output_device"))
{
int saved_device = sd.read_int("output_device");
uint device_count = get_sound_output_device_count();
if(saved_device >= 0 && uint(saved_device) < device_count)
{
set_sound_output_device(uint(saved_device));
}
}
if (sd.d.exists("gamemus_volume"))
{
gamemus_volume = sd.read_int("gamemus_volume");
}
if (sd.d.exists("stereo_positioning"))
{
stereo_positioning = sd.read_bool("stereo_positioning");
}
if (sd.d.exists("time_race_unlocked"))
{
time_race_unlocked = sd.read_bool("time_race_unlocked");
}
}
void writedata()
{
sd.add("menumusvolume", menumusvolume);
sd.add("use_sr", use_sr);
sd.add("tts_config", tts_dump_config(tts, true));
sd.add("output_device", int(get_sound_output_device()));
sd.add("gamemus_volume", gamemus_volume);
sd.add("stereo_positioning", stereo_positioning);
sd.add("time_race_unlocked", time_race_unlocked);
sd.save();
}

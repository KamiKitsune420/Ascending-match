void mainmenu()
{
setupmenu();
m.add_item("Play", "pl");
m.add_item("Help", "hp");
m.add_item("Exit", "ex");
m.intro_text = "Welcome to Ascending Match! Use your navigation keys to move, and press enter to select an option.";
int mres = m.run();
string main = m.get_selected_item_id();
if(mres==-1)
{
speak("exiting");
m.fade_music();
exit();
}
if (main == "pl")
{
speak("loading");
m.fade_music();
gamemus.load("game1.wav");
gamemus.volume=-15;
gamemus.pitch=85;
gamemus.play_looped();
gamesetup();
game();
}
if (main == "hp")
{
speak("loading");
m.fade_music();
sctext("Welcome to Ascending Match!", 30, "dlgopn.wav", "gamevoice.wav");
sctext("Your goal is to match numbers in ascending order.", 30, "dlgopn.wav", "gamevoice.wav");
sctext("to do this, use you're left and right arrow keys to navigate in the number list, and press the spacebar to select numbers for marking.", 30, "dlgopn.wav", "gamevoice.wav");
sctext("When you select two numbers, they swap positions in the list with each other.", 30, "dlgopn.wav", "gamevoice.wav");
sctext("to learn more, check the readme.", 30, "dlgopn.wav", "gamevoice.wav");
mainmenu();
}
if (main == "ex")
{
speak("exiting");
m.fade_music();
exit();
}
}

class score_entry
{
    string player_name;
    int round_reached;
    double accuracy_percent;
    uint64 timestamp;
    int total_swaps;
    int correct_swaps;
    int time_bonus;
    string game_mode; // "Normal" or "Time Race"
    
    score_entry()
    {
        player_name = "";
        round_reached = 0;
        accuracy_percent = 0.0;
        timestamp = 0;
        total_swaps = 0;
        correct_swaps = 0;
        time_bonus = 0;
        game_mode = "Normal";
    }
    
    score_entry(string name, int round, int total, int correct, uint64 time, int bonus = 0, string mode = "Normal")
    {
        player_name = name;
        round_reached = round;
        total_swaps = total;
        correct_swaps = correct;
        timestamp = time;
        time_bonus = bonus;
        game_mode = mode;
        
        if (total > 0) {
            accuracy_percent = (double(correct) / double(total)) * 100.0;
        } else {
            accuracy_percent = 0.0;
        }
    }
}

class scoreboard
{
    score_entry[] local_scores;
    savedata@ score_data;
    
    scoreboard()
    {
        @score_data = savedata("data/game.dat", "ApLNtsWrYHFl8xnV9L6BCCR9D0m2copzogusgPCjyi6RiWBxaB5af7yfvukIVrOvnUUnR3pNPIj7Gynrj5uqy2UvI2OTM8IfAXvdjOfzGPh3caFw8oYbOenAntgunq3t1ZkYf1H3byLAGYQctbLyqiFwULTy1jvras9DjprhgWBo12XJRmqVwMh61dtqwr3LlHKjBTBA1Ggi7Mw");
        load_scores();
    }
    
    void add_localscore(string player_name, int round_reached, int total_swaps, int correct_swaps, int time_bonus = 0, string game_mode = "Normal")
    {
        uint64 current_time = get_TIME_STAMP();
        score_entry new_entry(player_name, round_reached, total_swaps, correct_swaps, current_time, time_bonus, game_mode);
        
        local_scores.insert_last(new_entry);
        
        // Sort by round reached (descending), then by accuracy (descending)
        sort_scores();
        
        // Keep only top 10 scores
        if (local_scores.length() > 10) {
            local_scores.resize(10);
        }
        
        save_scores();
    }
    
    void get_localscores()
    {
        if (local_scores.length() == 0) {
            alert("error", "No local scores recorded yet!");
            return;
        }
        
        // First, show mode selection menu
        setupmenu();
        m.add_item("Normal Mode Scores", "normal");
        m.add_item("Time Race Mode Scores", "race");
        m.add_item("All Scores", "all");
        m.add_item("Clear all scores", "clear");
        m.add_item("Return", "return");
        m.intro_text = "Select which scoreboard to view. Use your navigation keys to move, and press enter to select.";       
        int res = m.run();
        string selected = m.get_item_id(res);
        
        if (res == -1 || selected == "return") {
            return;
        }        
        if (selected == "clear")
{
setupmenu();
    m.add_item("Yes", "yes");
    m.add_item("No", "no");
m.intro_text="Are you sure you want to clear all local scores?";
int mres=m.run();
string confirm = m.get_item_id(mres);
    if (mres == -1 or confirm == "no")
    {
return;
}
if(confirm=="yes")
{
                clear_scores();
                speak("All scores cleared.");
return;
}
}
        // Show selected scoreboard
        string mode_filter = "";
        if (selected == "normal") mode_filter = "Normal";
        else if (selected == "race") mode_filter = "Time Race";
        
        show_scores_for_mode(mode_filter);
    }
    
    private void show_scores_for_mode(string mode_filter)
    {
        // Filter scores by mode
        score_entry[] filtered_scores;
        for (uint i = 0; i < local_scores.length(); i++) {
            if (mode_filter == "" || local_scores[i].game_mode == mode_filter) {
                filtered_scores.insert_last(local_scores[i]);
            }
        }
        
        if (filtered_scores.length() == 0) {
            string mode_name = mode_filter == "" ? "any mode" : mode_filter.lower() + " mode";
            alert("error", "No scores found for " + mode_name + "!");
            return;
        }
        
        setupmenu();
        
        for (uint i = 0; i < filtered_scores.length(); i++) {
            string entry_text = (i + 1) + ": " + filtered_scores[i].player_name + 
                              ", " + filtered_scores[i].game_mode + " mode";
            if (filtered_scores[i].game_mode == "Normal") {
                entry_text += ", round " + filtered_scores[i].round_reached;
            } else {
                entry_text += ", completed in " + (filtered_scores[i].round_reached > 0 ? "victory" : "defeat");
            }
            entry_text += ", accuracy " + format_float(filtered_scores[i].accuracy_percent, "", 0, 1) + "%";
            if (filtered_scores[i].time_bonus > 0) {
                entry_text += ", bonus " + filtered_scores[i].time_bonus;
            }
            m.add_item(entry_text, "score_" + i);
        }
        
        m.add_item("Return", "return");
        string title = mode_filter == "" ? "All Local Scores" : mode_filter + " Mode Scores";
        m.intro_text = title + ". Use your navigation keys to browse the scores.";
        
        while (true) {
            int res = m.run();
            string selected = m.get_item_id(res);
            
            if (res == -1 || selected == "return") {
                break;
            }
            
            // Show detailed score info
            if (selected.substr(0, 6) == "score_") {
                uint index = parse_int(selected.substr(6));
                if (index < filtered_scores.length()) {
                    show_detailed_score_filtered(filtered_scores[index]);
                }
            }
        }
    }
    
    private void show_detailed_score_filtered(score_entry entry)
    {
        string details = "Player: " + entry.player_name + "\n" +
                        "Game Mode: " + entry.game_mode + "\n";
        if (entry.game_mode == "Normal") {
            details += "Round reached: " + entry.round_reached + "\n";
        } else {
            details += "Race Result: " + (entry.round_reached > 0 ? "Victory" : "Defeat") + "\n";
        }
        details += "Total swaps made: " + entry.total_swaps + "\n" +
                  "Correct swaps: " + entry.correct_swaps + "\n" +
                  "Accuracy: " + format_float(entry.accuracy_percent, "", 0, 2) + "%\n" +
                  "Time bonus points: " + entry.time_bonus + "\n" +
                  "Date achieved: " + format_timestamp(entry.timestamp);
        
        info_box("Score Details", "Detailed information for this score:", details);
    }
    
    private void show_detailed_score(uint index)
    {
        score_entry@ entry = @local_scores[index];
        string details = "Player: " + entry.player_name + "\n" +
                        "Round reached: " + entry.round_reached + "\n" +
                        "Total swaps made: " + entry.total_swaps + "\n" +
                        "Correct swaps: " + entry.correct_swaps + "\n" +
                        "Accuracy: " + format_float(entry.accuracy_percent, "", 0, 2) + "%\n" +
                        "Time bonus points: " + entry.time_bonus + "\n" +
                        "Date achieved: " + format_timestamp(entry.timestamp);
        
        info_box("Score Details", "Detailed information for this score:", details);
    }
    
    private string format_timestamp(uint64 timestamp)
    {
        // Simple timestamp formatting - you might want to enhance this
        return "Score #" + timestamp;
    }
    
    private void sort_scores()
    {
        // Simple bubble sort by round reached (descending), then accuracy (descending)
        for (uint i = 0; i < local_scores.length() - 1; i++) {
            for (uint j = 0; j < local_scores.length() - 1 - i; j++) {
                bool should_swap = false;
                
                // Primary sort: round reached (higher is better)
                if (local_scores[j].round_reached < local_scores[j + 1].round_reached) {
                    should_swap = true;
                } 
                // Secondary sort: if same round, sort by accuracy (higher is better)
                else if (local_scores[j].round_reached == local_scores[j + 1].round_reached) {
                    if (local_scores[j].accuracy_percent < local_scores[j + 1].accuracy_percent) {
                        should_swap = true;
                    }
                }
                
                if (should_swap) {
                    score_entry temp = local_scores[j];
                    local_scores[j] = local_scores[j + 1];
                    local_scores[j + 1] = temp;
                }
            }
        }
    }
    
    private void save_scores()
    {
        // Save each score entry
        for (uint i = 0; i < local_scores.length(); i++) {
            string prefix = "score_" + i + "_";
            score_data.add(prefix + "name", local_scores[i].player_name);
            score_data.add(prefix + "round", local_scores[i].round_reached);
            score_data.add(prefix + "accuracy", local_scores[i].accuracy_percent);
            score_data.add(prefix + "timestamp", int64(local_scores[i].timestamp));
            score_data.add(prefix + "total_swaps", local_scores[i].total_swaps);
            score_data.add(prefix + "correct_swaps", local_scores[i].correct_swaps);
            score_data.add(prefix + "time_bonus", local_scores[i].time_bonus);
            score_data.add(prefix + "game_mode", local_scores[i].game_mode);
        }
        
        score_data.add("score_count", int(local_scores.length()));
        score_data.save();
    }
    
    private void load_scores()
    {
        score_data.load();
        
        if (!score_data.d.exists("score_count")) {
            return; // No scores saved yet
        }
        
        int count = score_data.read_int("score_count");
        local_scores.resize(0);
        
        for (int i = 0; i < count; i++) {
            string prefix = "score_" + i + "_";
            
            if (score_data.d.exists(prefix + "name")) {
                score_entry entry;
                entry.player_name = score_data.read_string(prefix + "name");
                entry.round_reached = score_data.read_int(prefix + "round");
                entry.accuracy_percent = score_data.read_double(prefix + "accuracy");
                entry.timestamp = uint64(score_data.read_int64(prefix + "timestamp"));
                entry.total_swaps = score_data.read_int(prefix + "total_swaps");
                entry.correct_swaps = score_data.read_int(prefix + "correct_swaps");
                
                // Load time bonus (with backwards compatibility)
                if (score_data.d.exists(prefix + "time_bonus")) {
                    entry.time_bonus = score_data.read_int(prefix + "time_bonus");
                } else {
                    entry.time_bonus = 0; // Default for old saves
                }
                
                // Load game mode (with backwards compatibility)
                if (score_data.d.exists(prefix + "game_mode")) {
                    entry.game_mode = score_data.read_string(prefix + "game_mode");
                } else {
                    entry.game_mode = "Normal"; // Default for old saves
                }
                
                local_scores.insert_last(entry);
            }
        }
    }
    
    void clear_scores()
    {
        local_scores.resize(0);
        score_data.d.delete_all();
        score_data.save();
    }
    
    int get_score_count()
    {
        return int(local_scores.length());
    }
    
    bool is_high_score(int round_reached, double accuracy)
    {
        if (local_scores.length() < 10) {
            return true; // Always a high score if we have less than 10
        }
        
        // Check if this score would make it into top 10
        score_entry worst_score = local_scores[local_scores.length() - 1];
        
        if (round_reached > worst_score.round_reached) {
            return true;
        } else if (round_reached == worst_score.round_reached && accuracy > worst_score.accuracy_percent) {
            return true;
        }
        
        return false;
    }
}
touch_gesture_manager@ touchManager;
touch_keyboard_interface@ touchKB;

bool is_touch_platform()
{
    return system_is_mobile;
}

void init_touch()
{
    @touchManager = touch_gesture_manager();
    dictionary keymap;
    // 1-finger gestures
    keymap.set("swipe_left1f", KEY_LEFT);
    keymap.set("swipe_right1f", KEY_RIGHT);
    keymap.set("swipe_up1f", KEY_UP);
    keymap.set("swipe_down1f", KEY_DOWN);
    keymap.set("single_tap1f", KEY_SPACE);      // mark number
    keymap.set("double_tap1f", KEY_RETURN);     // confirm / advance dialog
    keymap.set("triple_tap1f", KEY_C);          // copy text (dlg copy)
    keymap.set("long_press1f", KEY_H);          // hint
    // 2-finger gestures
    keymap.set("single_tap2f", KEY_ESCAPE);     // back / exit
    keymap.set("double_tap2f", KEY_P);          // pause / unpause
    keymap.set("long_press2f", KEY_T);          // announce time remaining
    keymap.set("swipe_up2f", KEY_PAGEUP);       // volume up
    keymap.set("swipe_down2f", KEY_PAGEDOWN);   // volume down
    keymap.set("swipe_left2f", KEY_HOME);       // jump to first number
    keymap.set("swipe_right2f", KEY_END);       // jump to last number
    // 3-finger gestures
    keymap.set("single_tap3f", KEY_TAB);        // re-read menu title
    keymap.set("double_tap3f", KEY_F3);         // search in menu
    @touchKB = touch_keyboard_interface(touchManager, keymap);
    touchManager.add_touch_interface(touchKB);
}

void update_touch()
{
    if (@touchManager != null)
        touchManager.monitor();
}

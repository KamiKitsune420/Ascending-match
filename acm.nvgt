void play_curmove_sound()
{
if (stereo_positioning && nums.length() > 1)
{
float pan = -100.0 + (200.0 * numker / (nums.length() - 1));
p.play_stationary_extended("curmove.wav", false, 0, pan, 0.0, 100.0);
}
else
{
p.play_stationary("curmove.wav", false);
}
}

void play_edge_sound()
{
if (stereo_positioning && nums.length() > 1)
{
float pan = -100.0 + (200.0 * numker / (nums.length() - 1));
p.play_stationary_extended("edge.wav", false, 0, pan, 0.0, 100.0);
}
else
{
p.play_stationary("edge.wav", false);
}
}

string format_number_for_speech(double num)
{
    if (num == floor(num)) {
        // It's a whole number
        return "" + int(num);
    } else {
        // It's a decimal - format with appropriate precision
        return format_float(num, "", 0, 2);
    }
}

bool is_beneficial_swap(int pos1, int pos2)
{
    // Create a sorted copy to compare against
    double[] sorted_nums;
    for (uint i = 0; i < nums.length(); i++) {
        sorted_nums.insert_last(nums[i]);
    }
    sorted_nums.sort_ascending();
    
    // Check how many positions are correct before the swap
    int correct_before = 0;
    for (uint i = 0; i < nums.length(); i++) {
        if (nums[i] == sorted_nums[i]) {
            correct_before++;
        }
    }
    
    // Simulate the swap
    double temp = nums[pos1];
    nums[pos1] = nums[pos2];
    nums[pos2] = temp;
    
    // Check how many positions are correct after the swap
    int correct_after = 0;
    for (uint i = 0; i < nums.length(); i++) {
        if (nums[i] == sorted_nums[i]) {
            correct_after++;
        }
    }
    
    // Restore original order
    temp = nums[pos1];
    nums[pos1] = nums[pos2];
    nums[pos2] = temp;
    
    // Return true if the swap increases the number of correct positions
    return correct_after > correct_before;
}

double generate_number_for_round(int round)
{
    if (round < 8) {
        // Rounds 1-7: Simple integers 1-99
        return double(random(1, 99));
    } else if (round < 12) {
        // Rounds 8-11: Decimal numbers 1.0-99.9
        int whole = random(1, 99);
        int decimal = random(1, 9);
        return double(whole) + (double(decimal) / 10.0);
    } else if (round < 15) {
        // Rounds 12-14: Mix of positive and negative integers
        int num = random(1, 99);
        return random_bool() ? double(num) : double(-num);
    } else if (round < 20) {
        // Rounds 15-19: Larger range with negatives (1-999)
        int num = random(1, 999);
        return random_bool() ? double(num) : double(-num);
    } else if (round < 25) {
        // Rounds 20-24: Mix of integers, decimals, and negatives
        if (random(1, 3) == 1) {
            // Integer
            int num = random(1, 999);
            return random_bool() ? double(num) : double(-num);
        } else {
            // Decimal
            int whole = random(1, 999);
            int decimal = random(1, 9);
            double result = double(whole) + (double(decimal) / 10.0);
            return random_bool() ? result : -result;
        }
    } else {
        // Round 25+: Close decimal precision challenge
        int base = random(1, 50);
        int decimal = random(1, 99);
        double result = double(base) + (double(decimal) / 100.0);
        return random_bool() ? result : -result;
    }
}

string audio_name_entry()
{
    sctext("High score achieved! Time to enter your name.", 40, "dlgopn.wav", "gamevoice.wav");
    
    audio_form f;
    f.create_window("High Score!");
    int name_input = f.create_input_box("Enter your name:", "", "", 20);
    int ok_button = f.create_button("OK", true);
    int cancel_button = f.create_button("Cancel", false, true);
    
    f.focus(name_input);
    
    while (true) {
        wait(5);
        f.monitor();
        
        if (f.is_pressed(ok_button)) {
            string name = f.get_text(name_input);
            if (name.length() > 0) {
                speak("Name confirmed: " + name);
                return name;
            } else {
                speak("Please enter at least one character.");
                f.focus(name_input);
            }
        }
        
        if (f.is_pressed(cancel_button)) {
            speak("Name entry cancelled. Using Anonymous.");
            return "Anonymous";
        }
    }
    
    // Fallback (should never reach here)
    return "Anonymous";
}

void check_round_achievements()
{
    if (gameround == 2) {
        ach.award("First Steps", "You completed your first round! You're getting the hang of this number sorting business.");
    } else if (gameround == 5) {
        ach.award("Getting Warmed Up", "Five rounds completed! The numbers are getting trickier, but you're keeping up.");
    } else if (gameround == 8) {
        ach.award("Decimal Master", "You've mastered the basics and conquered your first decimal numbers!");
    } else if (gameround == 10) {
        ach.award("Double Digits", "Ten rounds! You're officially in the big leagues now.");
    } else if (gameround == 12) {
        ach.award("Negative Nancy", "You've successfully sorted negative numbers! Math class is paying off.");
    } else if (gameround == 15) {
        ach.award("Lucky Fifteen", "Fifteen rounds of number sorting mastery! The developer is impressed.");
    } else if (gameround == 20) {
        ach.award("The Twenties Club", "Twenty rounds! You're now handling mixed number types like a pro.");
    } else if (gameround == 25) {
        ach.award("Precision Expert", "Twenty-five rounds! You've entered the realm of precision decimals. Few have made it this far.");
    } else if (gameround == 30) {
        ach.award("Sorting Legend", "Thirty rounds! You are officially a number sorting legend. The developer bows to your skills.");
    } else if (gameround == 50) {
        ach.award("The Ultimate Sorter", "FIFTY ROUNDS! You have achieved the impossible. You are the ultimate number sorting champion!");
    } else if (gameround == 100) {
        ach.award("sooooo... board...", "huh. you actually made it this far? I err, didn't expect this. maybe put down the game and take a break? you know what? take this for you're trouble!:p");
    }
}

void handle_game_over()
{
    double accuracy = 0.0;
    if (total_swaps > 0) {
        accuracy = (double(correct_swaps) / double(total_swaps)) * 100.0;
    }
    
    string stats = "Game Statistics: Round reached " + gameround + ", Total swaps " + total_swaps + ", Correct swaps " + correct_swaps + ", Accuracy " + format_float(accuracy, "", 0, 1) + " percent.";
    
    sctext(stats, 40, "dlgopn.wav", "gamevoice.wav");
    
    // Check for accuracy achievements
    if (total_swaps > 0) {
        if (accuracy >= 90.0) {
            ach.award("Precision Player", "You achieved 90% or higher accuracy! Your sorting skills are incredibly precise.");
        } else if (accuracy >= 75.0) {
            ach.award("Accurate Sorter", "You achieved 75% or higher accuracy! Most of your swaps were beneficial.");
        } else if (accuracy >= 50.0) {
            ach.award("Getting Better", "You achieved 50% or higher accuracy! You're learning the optimal sorting strategies.");
        } else if (accuracy == 0.0) {
            ach.award("Master of Chaos", "Congratulations! You achieved 0% accuracy. Every single swap made things worse. This is actually impressive in its own special way. Maybe try the opposite of what you think next time?");
        }
        
        if (total_swaps >= 100) {
            ach.award("Swap Master", "You made 100 or more swaps! That's a lot of number rearranging.");
        }
        
        if (total_swaps >= 500) {
            ach.award("Swap Maniac", "You made 500 or more swaps! You really love moving those numbers around.");
        }
    } else if (total_swaps == 0) {
        ach.award("The Great Contemplator", "You sat through an entire round without making a single swap. Were you meditating? Taking a nap? Or perhaps you're playing some advanced form of number zen that us mere mortals don't understand. Either way, that's dedication to doing absolutely nothing!");
    }
    
    // Check for hint achievements
    if (hints_used == 0 && total_swaps > 0) {
        ach.award("The Independent Thinker", "You completed the game without using a single hint! Either you're incredibly skilled, or you're too proud to ask for help. We respect both possibilities.");
    } else if (hints_used > 5) {
        ach.award("The Hint Addict", "You used more than 5 hints in a single game! At this point, the game is practically playing itself. Maybe next time try trusting your own brain a little more? It's not as scary as it seems, we promise!");
    }
    
    // Check if this is a high score
    if (cb.is_high_score(gameround, accuracy) && total_swaps > 0) {
        string player_name = audio_name_entry();
        
        if (player_name != "") {
            cb.add_localscore(player_name, gameround, total_swaps, correct_swaps);
            sctext("Your score has been saved to the leaderboard!", 30, "dlgopn.wav", "gamevoice.wav");
        }
    } else {
        sctext("Thanks for playing! Try again to beat the high scores.", 30, "dlgopn.wav", "gamevoice.wav");
    }
}

void main()
{
set_sound_storage("*");
set_sound_decryption_key("",true);
    show_window("AscendingMatch, version "+version);
readpreffs();
    gameround=1;
    
    // Award welcome achievement on first play
    if (!ach.has_achievement("Welcome to Ascending Match!")) {
        ach.award("Welcome to Ascending Match!", "Welcome to the world of number sorting! Get ready to challenge your mind and reflexes.");
    }
    
    wait(500);
    speak("Press enter to start.");
    dlgplay("TITLEBIT.wav");
    mainmenu();
}
void gamesetup()
{
    nums.resize(0);
    marknums.resize(0);
    
    // Reset game round and accuracy tracking for new game
    gameround = 1;
    total_swaps = 0;
    correct_swaps = 0;
    hints_used = 0;    
    if (gameround >= 1 && gameround < 5) {
        amount = random(5, 10);
    } else if (gameround >= 5 && gameround <= 10) {
        amount = random(10, 15);
    } else if (gameround > 10 && gameround < 20) {
        amount = random(15, 25);
    } else {
        amount = random(30, 50);
    }
    for (int i = 0; i < amount; i++) {
        double new_num;
        do {
            new_num = generate_number_for_round(gameround);
        } while (nums.find(new_num) != -1);
        nums.insert_last(new_num);
    }
    
    numker = 0;
    for (int i = 0; i < amount; i++) {
        marknums.insert_last(false);
    }
    
    string announcement = "Round " + gameround + ". Numbers to arrange: " + amount + ".";
    
    // Add difficulty announcements
    if (gameround == 8) {
        announcement += " New challenge: Decimal numbers introduced!";
    } else if (gameround == 12) {
        announcement += " New challenge: Negative numbers added!";
    } else if (gameround == 15) {
        announcement += " New challenge: Larger number ranges!";
    } else if (gameround == 20) {
        announcement += " New challenge: Mixed number types!";
    } else if (gameround == 25) {
        announcement += " Ultimate challenge: Precision decimals!";
    }
    
    speak(announcement);
   
    if (gameround <= 6) {
        round_time_left = 120;
    } else if (gameround <= 12) {
        round_time_left = 90;
    } else if (gameround <= 20) {
        round_time_left = 60;
    } else {
        round_time_left = 45;
    }

    round_timer.restart();
    tick_timer.restart();
    tick.load("clock.wav");
}

void game()
{
    while (true)
    {
        wait(5);
                if (key_repeating(KEY_HOME)) {
            if (nums.length() > 0) {
                numker = 0;
                play_curmove_sound();
                if (marknums[numker]) {
                    speak(format_number_for_speech(nums[numker]) + " (Marked)");
                } else {
                    speak(format_number_for_speech(nums[numker]));
                }
            } else {
                play_edge_sound();
            }
        }

        if (key_repeating(KEY_END)) {
            if (nums.length() > 0) {
                numker = int(nums.length()) - 1;
                play_curmove_sound();
                if (marknums[numker]) {
                    speak(format_number_for_speech(nums[numker]) + " (Marked)");
                } else {
                    speak(format_number_for_speech(nums[numker]));
                }
            } else {
                play_edge_sound();
            }
        }
        if (key_pressed(KEY_P)) {
            game_paused = !game_paused;
            if (game_paused) {
                gamemus.pause();
                speak("Game paused.");
            } else {
                gamemus.volume = gamemus_volume;
                gamemus.play_looped();
                speak("Game resumed.");
            }
        }
        
        if (game_paused) {
            continue;
        }

        if (tick_timer.elapsed >= 1000) {
            round_time_left--;
            tick_timer.restart();

            if (round_time_left < 21) {
                tick.play();
            }

            if (round_time_left <= 0) {
                gamemus.stop();
                speak("Time's up. Game over.");
                p.play_stationary("gameover.wav", false);
                wait(1000);
                handle_game_over();
                mainmenu();
            }
        }        
        if(key_down(KEY_PAGEUP)) {
            gamemus_volume += 1;
            if(gamemus_volume > 0) gamemus_volume = 0;
            gamemus.volume = gamemus_volume;
        } else if(key_down(KEY_PAGEDOWN)) {
            gamemus_volume -= 1;
            if(gamemus_volume < -50) gamemus_volume = -50;
            gamemus.volume = gamemus_volume;
        }
        
        if (key_repeating(KEY_RIGHT)) {
            if (numker < int(nums.length()) - 1) {
                numker++;
                play_curmove_sound();
                if (marknums[numker]) {
                    speak(format_number_for_speech(nums[numker]) + " (Marked)");
                } else {
                    speak(format_number_for_speech(nums[numker]));
                }
            } else {
                play_edge_sound();
            }
        }
        
        if (key_repeating(KEY_LEFT)) {
            if (numker > 0) {
                numker--;
                play_curmove_sound();
                if (marknums[numker]) {
                    speak(format_number_for_speech(nums[numker]) + " (Marked)");
                } else {
                    speak(format_number_for_speech(nums[numker]));
                }
            } else {
                play_edge_sound();
            }
        }
        
        if (key_repeating(KEY_SPACE)) {
            marknums[numker] = !marknums[numker];
            int count = 0;
            int first = -1, second = -1;
            for (int i = 0; i < int(marknums.length()); i++) {
                if (marknums[i]) {
                    count++;
                    if (first == -1)
                        first = i;
                    else
                        second = i;
                }
            }
            if (count == 2) {
                // Check if this swap brings numbers closer to correct order
                bool is_good_swap = is_beneficial_swap(first, second);
                
                double temp = nums[first];
                nums[first] = nums[second];
                nums[second] = temp;
                
                total_swaps++;
                if (is_good_swap) {
                    correct_swaps++;
                }
                
                p.play_stationary("swap.wav", false);
                speak("Swapped");
                for (int i = 0; i < int(marknums.length()); i++)
                    marknums[i] = false;
                bool sorted = true;
                for (int i = 0; i < int(nums.length()) - 1; i++) {
                    if (nums[i] > nums[i + 1]) {
                        sorted = false;
                        break;
                    }
                }
                if (sorted) {
                    p.play_stationary("nextround.wav", false);
                    speak("Round complete!");
                    wait(1000);
                    gameround++;
                    
                    // Check for achievements
                    check_round_achievements();
                    
                    gamemus.pitch+=1;
                    gamesetup();
                    game();
                    return;
                }
            } else {
                if (marknums[numker]) {
                    p.play_stationary("marked.wav", false);
                    speak("Marked");
                } else {
                    p.play_stationary("unmarked.wav", false);
                    speak("Unmarked");
                }
            }
            wait(150);
        }        
        if (key_pressed(KEY_H)) {
            if (hint_timer.elapsed < HINT_COOLDOWN) {
                int secondsLeft = (HINT_COOLDOWN - hint_timer.elapsed) / 1000;
                speak("You can't use a hint yet. Please wait " + secondsLeft + " more second" + (secondsLeft == 1 ? "" : "s") + ".");
                p.play_stationary("hinterror.wav", false);
            } else {
                int correct = 0;
                int wrong = 0;
                double[] sorted_nums;
                for (uint i = 0; i < nums.length(); i++) {
                    sorted_nums.insert_last(nums[i]);
                }
                sorted_nums.sort_ascending();

                for (uint i = 0; i < nums.length(); i++) {
                    if (nums[i] == sorted_nums[i]) {
                        correct++;
                    } else {
                        wrong++;
                    }
                }

                speak(correct + " number" + (correct == 1 ? " is" : "s are") + " in the correct spot. " + wrong + " " + (wrong == 1 ? "is" : " are") + " out of place.");
                p.play_stationary("hint.wav", false);
                
                hints_used++;
                hint_timer.restart(); 
            }
        }
        
        if (key_pressed(KEY_T)) {
            if (round_time_left >= 60) {
                int minutes = round_time_left / 60;
                int seconds = round_time_left % 60;
                speak(minutes + " minute" + (minutes == 1 ? "" : "s") + " and " + seconds + " second" + (seconds == 1 ? "" : "s") + " remaining.");
            } else {
                speak(round_time_left + " second" + (round_time_left == 1 ? "" : "s") + " remaining.");
            }
        }

        if (key_pressed(KEY_ESCAPE)) {
            fade(gamemus);
            mainmenu();
        }
    }
}

#include"includes/includes.nvgt"
void main()
{
set_sound_storage("data/sounds.dat");
init_touch();
    show_window("AscendingMatch, version "+version);
readdata();    
    // Award welcome achievement on first play
    if (!ach.has_achievement("Welcome to Ascending Match!")) {
        ach.award("Welcome to Ascending Match!", "Welcome to the world of number sorting! Get ready to challenge your mind and reflexes.");
    }
    
    wait(500);
    if (is_touch_platform())
        speak("Double tap to start.");
    else
        speak("Press enter to start.");
    dlgplay("TITLEBIT.wav");
    mainmenu();
}

void init_new_game()
{
    // Initialize a completely new game
gameround=1;
    total_swaps = 0;
    correct_swaps = 0;
    hints_used = 0;
    time_bonus_total = 0;
    }

void init_time_race()
{
    // Initialize time race mode
    time_race_mode = true;
    gameround = 1;
    total_swaps = 0;
    correct_swaps = 0;
    hints_used = 0;
    computer_swaps = 0;
    computer_correct_swaps = 0;
    computer_finished = false;
    
    // Initialize progress tracking (20%, 40%, 60%, 80%)
    computer_progress_announced.resize(0);
    for (int i = 0; i < 4; i++) {
        computer_progress_announced.insert_last(false);
    }
    
    // Generate 25 random numbers for both player and computer
    nums.resize(0);
    computer_nums.resize(0);
    marknums.resize(0);
    
    amount = 25;
    for (int i = 0; i < 25; i++) {
        // Generate simple integers only for time race
        double new_num;
        do {
            // Only positive integers from 1 to 50 for easier sorting
            new_num = double(random(1, 50));
        } while (nums.find(new_num) != -1);
        
        nums.insert_last(new_num);
        computer_nums.insert_last(new_num); // Same numbers for fairness
        marknums.insert_last(false);
    }
    
    numker = 0;
    race_timer.restart();
    
}

void gamesetup()
{
    // Skip normal setup if in time race mode
    if (time_race_mode) {
        // For time race mode, we don't need a time limit
        round_time_left = 1000000; // Set very high so timer doesn't interfere
        return; // Time race uses its own setup
    }
    
    nums.resize(0);
    marknums.resize(0);
    
    // Only reset game stats for completely new games
    // gameround should NOT be reset here when called after completing a round
    
    if (gameround >= 1 && gameround < 5) {
        amount = random(5, 10);
    } else if (gameround >= 5 && gameround <= 10) {
        amount = random(10, 15);
    } else if (gameround > 10 && gameround < 20) {
        amount = random(15, 25);
    } else {
        amount = random(30, 50);
    }
    
    // Determine if this should be a reverse level (descending order)
    // 15% chance for reverse levels, but not in first 3 rounds
    reverse_level = false;
    if (gameround > 3 && random(1, 100) <= 15) {
        reverse_level = true;
    }
    
    for (int i = 0; i < amount; i++) {
        double new_num;
        do {
            new_num = generate_number_for_round(gameround);
        } while (nums.find(new_num) != -1);
        nums.insert_last(new_num);
    }
    
    numker = 0;
    for (int i = 0; i < amount; i++) {
        marknums.insert_last(false);
    }
    
    string announcement = "Round " + gameround + ". Numbers to arrange: " + amount + ".";
    
    // Add reverse level announcement
    if (reverse_level) {
        announcement += " SPECIAL CHALLENGE: Arrange numbers in DESCENDING order!";
    }
    
    // Add difficulty announcements
    if (gameround == 8) {
        announcement += " New challenge: Decimal numbers introduced!";
    } else if (gameround == 12) {
        announcement += " New challenge: Negative numbers added!";
    } else if (gameround == 15) {
        announcement += " New challenge: Larger number ranges!";
    } else if (gameround == 20) {
        announcement += " New challenge: Mixed number types including fractions!";
    } else if (gameround == 25) {
        announcement += " Ultimate challenge: Precision decimals and complex fractions!";
    }
    
    // Add range shrinking hints for certain rounds
    if ((gameround - 1) % 4 == 0 && gameround > 1) {
        announcement += " Number range is tightening for increased difficulty.";
    }
    
    speak(announcement);
   
    // Dynamic timing based on both round difficulty and number of items
    double base_time_per_number = 10.0; // Base seconds per number to sort (more generous)
    double base_time = 40.0; // Base time regardless of count (increased)
    double min_time = 60.0; // Minimum time for any round (back to reasonable)
    
    // Round difficulty multiplier (gradually decreases as rounds progress)
    double round_multiplier = 1.2; // Start with generous time for beginners
    if (gameround >= 4) {
        round_multiplier = 1.1; // Still generous for early learning
    }
    if (gameround >= 8) {
        // Decimal numbers introduced - maintain generous time
        round_multiplier = 1.05;
    }
    if (gameround >= 12) {
        // Negative numbers - standard time
        round_multiplier = 1.0;
    }
    if (gameround >= 15) {
        // Larger ranges - slight time reduction
        round_multiplier = 0.95;
    }
    if (gameround >= 20) {
        // Mixed types - moderate challenge
        round_multiplier = 0.9;
    }
    if (gameround >= 25) {
        // Precision decimals - highest difficulty but still fair
        round_multiplier = 0.85;
    }
    
    // Apply reverse level penalty (10% less time for added challenge)
    if (reverse_level) {
        round_multiplier *= 0.9;
    }
    
    // Apply shrinking range bonus (closer numbers are harder, give slight time bonus)
    if ((gameround - 1) % 4 >= 2) { // Later rounds in each tier get small bonus
        round_multiplier *= 1.05;
    }
    
    // Calculate total time: base time + (numbers * time per number * difficulty)
    double calculated_time = base_time + (amount * base_time_per_number * round_multiplier);
    
    // Store for bonus calculation
    last_calculated_time = calculated_time < min_time ? min_time : calculated_time;
    
    // Ensure minimum time and convert to int
    round_time_left = int(last_calculated_time);

    round_timer.restart();
    tick_timer.restart();
    tick.load("clock.wav");
}

void play_curmove_sound()
{
if (stereo_positioning && nums.length() > 1)
{
float pan = -100.0 + (200.0 * numker / (nums.length() - 1));
p.play_stationary_extended("curmove.wav", false, 0, pan, 0.0, 100.0);
}
else
{
p.play_stationary("curmove.wav", false);
}
}

void play_edge_sound()
{
if (stereo_positioning && nums.length() > 1)
{
float pan = -100.0 + (200.0 * numker / (nums.length() - 1));
p.play_stationary_extended("edge.wav", false, 0, pan, 0.0, 100.0);
}
else
{
p.play_stationary("edge.wav", false);
}
}

string format_number_for_speech(double num)
{
    if (num == floor(num)) {
        // It's a whole number
        return "" + int(num);
    } else {
        // It's a decimal - format with appropriate precision
        return format_float(num, "", 0, 2);
    }
}

bool is_beneficial_swap(int pos1, int pos2)
{
    // Create a sorted copy to compare against
    double[] sorted_nums;
    for (uint i = 0; i < nums.length(); i++) {
        sorted_nums.insert_last(nums[i]);
    }
    if (reverse_level) {
        sorted_nums.sort_descending();
    } else {
        sorted_nums.sort_ascending();
    }
    
    // Check how many positions are correct before the swap
    int correct_before = 0;
    for (uint i = 0; i < nums.length(); i++) {
        if (nums[i] == sorted_nums[i]) {
            correct_before++;
        }
    }
    
    // Simulate the swap
    double temp = nums[pos1];
    nums[pos1] = nums[pos2];
    nums[pos2] = temp;
    
    // Check how many positions are correct after the swap
    int correct_after = 0;
    for (uint i = 0; i < nums.length(); i++) {
        if (nums[i] == sorted_nums[i]) {
            correct_after++;
        }
    }
    
    // Restore original order
    temp = nums[pos1];
    nums[pos1] = nums[pos2];
    nums[pos2] = temp;
    
    // Return true if the swap increases the number of correct positions
    return correct_after > correct_before;
}

double generate_number_for_round(int round)
{
    // Calculate shrinking range within each difficulty tier
    int range_reduction = 0;
    
    if (round < 8) {
        // Rounds 1-7: Simple integers with shrinking range
        // Start at 1-99, shrink by 10 each round: 99, 89, 79, 69, 59, 49, 39
        range_reduction = (round - 1) * 10;
        int max_range = (99 - range_reduction) < 39 ? 39 : (99 - range_reduction); // Don't go below 39
        return double(random(1, max_range));
    } else if (round < 12) {
        // Rounds 8-11: Decimal numbers, reset range then shrink
        // Reset to full range at 8, then shrink: 99, 89, 79, 69
        range_reduction = (round - 8) * 10;
        int max_range = (99 - range_reduction) < 69 ? 69 : (99 - range_reduction);
        int whole = random(1, max_range);
        int decimal = random(1, 9);
        return double(whole) + (double(decimal) / 10.0);
    } else if (round < 15) {
        // Rounds 12-14: Negative/positive integers, reset range then shrink
        // Reset to full range, then shrink: 99, 89, 79
        range_reduction = (round - 12) * 10;
        int max_range = (99 - range_reduction) < 79 ? 79 : (99 - range_reduction);
        int num = random(1, max_range);
        // Only apply negative to non-zero numbers
        return (num == 0 || !random_bool()) ? double(num) : double(-num);
    } else if (round < 20) {
        // Rounds 15-19: Larger range with negatives, reset then shrink
        // Start at 1-999, shrink by 100 each round: 999, 899, 799, 699, 599
        range_reduction = (round - 15) * 100;
        int max_range = (999 - range_reduction) < 599 ? 599 : (999 - range_reduction);
        int num = random(1, max_range);
        // Only apply negative to non-zero numbers
        return (num == 0 || !random_bool()) ? double(num) : double(-num);
    } else if (round < 25) {
        // Rounds 20-24: Mix of integers/decimals/negatives, reset then shrink
        // Reset to 1-999, shrink by 100: 999, 899, 799, 699, 599
        range_reduction = (round - 20) * 100;
        int max_range = (999 - range_reduction) < 599 ? 599 : (999 - range_reduction);
        
        int type_choice = random(1, 4); // Add fractions as 4th option
        if (type_choice == 1) {
            // Integer
            int num = random(1, max_range);
            // Only apply negative to non-zero numbers
            return (num == 0 || !random_bool()) ? double(num) : double(-num);
        } else if (type_choice == 2) {
            // Decimal
            int whole = random(1, max_range);
            int decimal = random(1, 9);
            double result = double(whole) + (double(decimal) / 10.0);
            // Only apply negative to non-zero numbers
            return (result < 0.05 || !random_bool()) ? result : -result;
        } else {
            // Fraction (represented as decimal for sorting purposes)
            int numerator = random(1, 20);
            int denominator = random(2, 12);
            double result = double(numerator) / double(denominator);
            // Only apply negative to very small numbers (avoid negative zero and tiny fractions)
            return (result < 0.05 || !random_bool()) ? result : -result;
        }
    } else {
        // Round 25+: Mix of precision decimals and fractions, reset then shrink
        // Start at 1-50, shrink by 5: 50, 45, 40, 35, 30 (minimum 30)
        range_reduction = (round - 25) * 5;
        int max_base = (50 - range_reduction) < 30 ? 30 : (50 - range_reduction);
        
        if (random(1, 3) <= 2) {
            // Precision decimals (66% chance)
            int base = random(1, max_base);
            int decimal = random(1, 99);
            double result = double(base) + (double(decimal) / 100.0);
            // Only apply negative to non-zero numbers
            return (result < 0.05 || !random_bool()) ? result : -result;
        } else {
            // Complex fractions (33% chance)
            int numerator = random(1, max_base);
            int denominator = random(2, 20);
            double result = double(numerator) / double(denominator);
            // Only apply negative to very small numbers (avoid negative zero and tiny fractions)
            return (result < 0.05 || !random_bool()) ? result : -result;
        }
    }
}

string audio_name_entry()
{
    sctext("High score achieved! Time to enter your name.", 40, "dlgopn.wav", "gamevoice.wav");
    
    audio_form f;
    f.create_window("High Score!");
    int name_input = f.create_input_box("Enter your name:", "", "", 20);
    int ok_button = f.create_button("OK", true);
    int cancel_button = f.create_button("Cancel", false, true);
    
    f.focus(name_input);
    
    while (true) {
        wait(5);
        f.monitor();
        
        if (f.is_pressed(ok_button)) {
            string name = f.get_text(name_input);
            if (name.length() > 0) {
                speak("Name confirmed: " + name);
                return name;
            } else {
                speak("Please enter at least one character.");
                f.focus(name_input);
            }
        }
        
        if (f.is_pressed(cancel_button)) {
            speak("Name entry cancelled. Using Anonymous.");
            return "Anonymous";
        }
    }
    
    // Fallback (should never reach here)
    return "Anonymous";
}

void check_round_achievements()
{
    if (gameround == 2) {
        ach.award("First Steps", "You completed your first round! You're getting the hang of this number sorting business.");
    } else if (gameround == 5) {
        ach.award("Getting Warmed Up", "Five rounds completed! The numbers are getting trickier, but you're keeping up.");
    } else if (gameround == 8) {
        ach.award("Decimal Master", "You've mastered the basics and conquered your first decimal numbers!");
    } else if (gameround == 10) {
        ach.award("Double Digits", "Ten rounds! You're officially in the big leagues now.");
    } else if (gameround == 12) {
        ach.award("Negative Nancy", "You've successfully sorted negative numbers! Math class is paying off.");
    } else if (gameround == 15) {
        ach.award("Lucky Fifteen", "Fifteen rounds of number sorting mastery! The developer is impressed.");
    } else if (gameround == 20) {
        ach.award("The Twenties Club", "Twenty rounds! You're now handling mixed number types like a pro.");
    } else if (gameround == 25) {
        ach.award("Precision Expert", "Twenty-five rounds! You've entered the realm of precision decimals. Few have made it this far.");
    } else if (gameround == 30) {
        ach.award("Sorting Legend", "Thirty rounds! You are officially a number sorting legend. The developer bows to your skills.");
        // Check if this is the first time reaching round 30 to unlock time race
        if (stats.highest_round_reached < 30) {
            ach.award("Ready to Race", "You've unlocked Time Race mode! Now you can compete against the computer in high-speed number sorting challenges.");
            sctext("New feature unlocked: Time Race mode! You can now compete against the computer in fast-paced sorting challenges.", 40, "dlgopn.wav", "gamevoice.wav");
        }
    } else if (gameround == 50) {
        ach.award("The Ultimate Sorter", "FIFTY ROUNDS! You have achieved the impossible. You are the ultimate number sorting champion!");
    } else if (gameround == 100) {
        ach.award("sooooo... board...", "huh. you actually made it this far? I err, didn't expect this. maybe put down the game and take a break? you know what? take this for you're trouble!:p");
    }
    
    // Time bonus achievements
    if (time_bonus_total >= 100) {
        ach.award("Speedy Sorter", "You've earned your first 100 time bonus points! Your quick thinking is paying off.");
    }
    if (time_bonus_total >= 500) {
        ach.award("Lightning Fast", "500 time bonus points! You're consistently completing rounds at impressive speed.");
    }
    if (time_bonus_total >= 1000) {
        ach.award("Time Master", "1000 time bonus points! You've mastered the art of rapid number sorting.");
    }
    
    // Fraction milestone achievements
    if (gameround == 20) {
        ach.award("Fraction Pioneer", "You've reached round 20 and encountered your first fractions! Math class is really paying off now.");
    }
}

void handle_game_over()
{
    double accuracy = 0.0;
    if (total_swaps > 0) {
        accuracy = (double(correct_swaps) / double(total_swaps)) * 100.0;
    }
    
    string stats = "Game Statistics: Round reached " + gameround + ", Total swaps " + total_swaps + ", Correct swaps " + correct_swaps + ", Accuracy " + format_float(accuracy, "", 0, 1) + " percent";
    if (time_bonus_total > 0) {
        stats += ", Time bonus points " + time_bonus_total;
    }
    stats += ".";
    
    sctext(stats, 40, "dlgopn.wav", "gamevoice.wav");
    
    // Check for accuracy achievements
    if (total_swaps > 0) {
        if (accuracy >= 90.0) {
            ach.award("Precision Player", "You achieved 90% or higher accuracy! Your sorting skills are incredibly precise.");
        } else if (accuracy >= 75.0) {
            ach.award("Accurate Sorter", "You achieved 75% or higher accuracy! Most of your swaps were beneficial.");
        } else if (accuracy >= 50.0) {
            ach.award("Getting Better", "You achieved 50% or higher accuracy! You're learning the optimal sorting strategies.");
        } else if (accuracy == 0.0) {
            ach.award("Master of Chaos", "Congratulations! You achieved 0% accuracy. Every single swap made things worse. This is actually impressive in its own special way. Maybe try the opposite of what you think next time?");
        }
        
        if (total_swaps >= 100) {
            ach.award("Swap Master", "You made 100 or more swaps! That's a lot of number rearranging.");
        }
        
        if (total_swaps >= 500) {
            ach.award("Swap Maniac", "You made 500 or more swaps! You really love moving those numbers around.");
        }
    } else if (total_swaps == 0) {
        ach.award("The Great Contemplator", "You sat through an entire round without making a single swap. Were you meditating? Taking a nap? Or perhaps you're playing some advanced form of number zen that us mere mortals don't understand. Either way, that's dedication to doing absolutely nothing!");
    }
    
    // Check for hint achievements
    if (hints_used == 0 && total_swaps > 0) {
        ach.award("The Independent Thinker", "You completed the game without using a single hint! Either you're incredibly skilled, or you're too proud to ask for help. We respect both possibilities.");
    } else if (hints_used > 5) {
        ach.award("The Hint Addict", "You used more than 5 hints in a single game! At this point, the game is practically playing itself. Maybe next time try trusting your own brain a little more? It's not as scary as it seems, we promise!");
    }
    
    // Record game completion statistics
    // stats.record_game_completion(gameround - 1, accuracy, time_bonus_total, gameround);
    
    // Check if this is a high score
    if (cb.is_high_score(gameround, accuracy) && total_swaps > 0) {
        string player_name = audio_name_entry();
        
        if (player_name != "") {
            string game_mode = time_race_mode ? "Time Race" : "Normal";
            cb.add_localscore(player_name, gameround, total_swaps, correct_swaps, time_bonus_total, game_mode);
            sctext("Your score has been saved to the leaderboard!", 30, "dlgopn.wav", "gamevoice.wav");
        }
    } else {
        sctext("Thanks for playing! Try again to beat the high scores.", 30, "dlgopn.wav", "gamevoice.wav");
    }
}

void main()
{
set_sound_storage("*");
set_sound_decryption_key("",true);
    show_window("AscendingMatch, version "+version);
readpreffs();
    gameround=1;
    
    // Award welcome achievement on first play
    if (!ach.has_achievement("Welcome to Ascending Match!")) {
        ach.award("Welcome to Ascending Match!", "Welcome to the world of number sorting! Get ready to challenge your mind and reflexes.");
    }
    
    wait(500);
    speak("Press enter to start.");
    dlgplay("TITLEBIT.wav");
    mainmenu();
}

void init_new_game()
{
    // Initialize a completely new game
    gameround = 1;
    total_swaps = 0;
    correct_swaps = 0;
    hints_used = 0;
    time_bonus_total = 0;
    
    // Set sound pool reference for achievements
    ach.set_sound_pool(p);
}

void init_time_race()
{
    // Initialize time race mode
    time_race_mode = true;
    gameround = 1;
    total_swaps = 0;
    correct_swaps = 0;
    hints_used = 0;
    computer_swaps = 0;
    computer_correct_swaps = 0;
    computer_finished = false;
    
    // Initialize progress tracking (20%, 40%, 60%, 80%)
    computer_progress_announced.resize(0);
    for (int i = 0; i < 4; i++) {
        computer_progress_announced.insert_last(false);
    }
    
    // Generate 25 random numbers for both player and computer
    nums.resize(0);
    computer_nums.resize(0);
    marknums.resize(0);
    
    amount = 25;
    for (int i = 0; i < 25; i++) {
        // Generate simple integers only for time race
        double new_num;
        do {
            // Only positive integers from 1 to 50 for easier sorting
            new_num = double(random(1, 50));
        } while (nums.find(new_num) != -1);
        
        nums.insert_last(new_num);
        computer_nums.insert_last(new_num); // Same numbers for fairness
        marknums.insert_last(false);
    }
    
    numker = 0;
    race_timer.restart();
    
    // Set sound pool reference for achievements
    ach.set_sound_pool(p);
}

timer ai_timer; // Move this to global scope
int ai_delay = 0; // Move this to global scope

void computer_ai_step()
{
    // Smarter AI that looks for good swaps
    if (ai_delay == 0) {
        ai_delay = random(1000, 2000); // Initialize delay first time
    }
    
    if (ai_timer.elapsed >= ai_delay) {
        // Find a good swap by looking for out-of-place numbers
        double[] sorted_nums;
        for (uint i = 0; i < computer_nums.length(); i++) {
            sorted_nums.insert_last(computer_nums[i]);
        }
        sorted_nums.sort_ascending();
        
        int pos1 = -1, pos2 = -1;
        
        // Look for numbers that are in wrong positions
        for (uint i = 0; i < computer_nums.length() && pos1 == -1; i++) {
            if (computer_nums[i] != sorted_nums[i]) {
                pos1 = i;
                // Find where this number should go
                for (uint j = 0; j < computer_nums.length(); j++) {
                    if (computer_nums[j] == sorted_nums[i] && i != j) {
                        pos2 = j;
                        break;
                    }
                }
            }
        }
        
        // If we couldn't find a perfect swap, or randomly make a mistake (30% chance)
        if (pos1 == -1 || pos2 == -1 || random(1, 100) <= 30) {
            pos1 = random(0, computer_nums.length() - 1);
            pos2 = random(0, computer_nums.length() - 1);
        }
        
        if (pos1 != pos2) {
            // Make the swap
            double temp = computer_nums[pos1];
            computer_nums[pos1] = computer_nums[pos2];
            computer_nums[pos2] = temp;
            
            computer_swaps++;
            
            // Check if this swap actually improved things
            int correct_after = 0;
            for (uint i = 0; i < computer_nums.length(); i++) {
                if (computer_nums[i] == sorted_nums[i]) {
                    correct_after++;
                }
            }
            
            // Sometimes the AI makes mistakes (70% accuracy target)
            if (random(1, 100) <= 70) {
                computer_correct_swaps++;
            }
            
            // Check if computer has completed the sort
            double[] check_sorted;
            for (uint i = 0; i < computer_nums.length(); i++) {
                check_sorted.insert_last(computer_nums[i]);
            }
            check_sorted.sort_ascending();
            
            bool computer_done = true;
            for (uint i = 0; i < computer_nums.length(); i++) {
                if (computer_nums[i] != check_sorted[i]) {
                    computer_done = false;
                    break;
                }
            }
            
            if (computer_done) {
                computer_finished = true;
            } else {
                // Check computer progress and announce milestones
                double[] sorted_nums;
                for (uint i = 0; i < computer_nums.length(); i++) {
                    sorted_nums.insert_last(computer_nums[i]);
                }
                sorted_nums.sort_ascending();
                
                int correct_positions = 0;
                for (uint i = 0; i < computer_nums.length(); i++) {
                    if (computer_nums[i] == sorted_nums[i]) {
                        correct_positions++;
                    }
                }
                
                double progress_percent = (double(correct_positions) / double(computer_nums.length())) * 100.0;
                
                // Announce progress milestones
                if (progress_percent >= 20.0 && !computer_progress_announced[0]) {
                    p.play_stationary("wrn.wav", false);
                    speak("Alert! The computer is 20 percent done, watch out!");
                    computer_progress_announced[0] = true;
                } else if (progress_percent >= 40.0 && !computer_progress_announced[1]) {
                    p.play_stationary("wrn.wav", false);
                    speak("Alert! The computer is 40 percent done, watch out!");
                    computer_progress_announced[1] = true;
                } else if (progress_percent >= 60.0 && !computer_progress_announced[2]) {
                    p.play_stationary("wrn.wav", false);
                    speak("Alert! The computer is 60 percent done, watch out!");
                    computer_progress_announced[2] = true;
                } else if (progress_percent >= 80.0 && !computer_progress_announced[3]) {
                    p.play_stationary("wrn.wav", false);
                    speak("Alert! The computer is 80 percent done, watch out!");
                    computer_progress_announced[3] = true;
                }
            }
        }
        
        ai_timer.restart();
        ai_delay = random(4000, 7000); // Next swap in 4-7 seconds (slower pace)
    }
}

void gamesetup()
{
    // Skip normal setup if in time race mode
    if (time_race_mode) {
        // For time race mode, we don't need a time limit
        round_time_left = 999999; // Set very high so timer doesn't interfere
        return; // Time race uses its own setup
    }
    
    nums.resize(0);
    marknums.resize(0);
    
    // Only reset game stats for completely new games
    // gameround should NOT be reset here when called after completing a round
    
    if (gameround >= 1 && gameround < 5) {
        amount = random(5, 10);
    } else if (gameround >= 5 && gameround <= 10) {
        amount = random(10, 15);
    } else if (gameround > 10 && gameround < 20) {
        amount = random(15, 25);
    } else {
        amount = random(30, 50);
    }
    
    // Determine if this should be a reverse level (descending order)
    // 15% chance for reverse levels, but not in first 3 rounds
    reverse_level = false;
    if (gameround > 3 && random(1, 100) <= 15) {
        reverse_level = true;
    }
    
    for (int i = 0; i < amount; i++) {
        double new_num;
        do {
            new_num = generate_number_for_round(gameround);
        } while (nums.find(new_num) != -1);
        nums.insert_last(new_num);
    }
    
    numker = 0;
    for (int i = 0; i < amount; i++) {
        marknums.insert_last(false);
    }
    
    string announcement = "Round " + gameround + ". Numbers to arrange: " + amount + ".";
    
    // Add reverse level announcement
    if (reverse_level) {
        announcement += " SPECIAL CHALLENGE: Arrange numbers in DESCENDING order!";
    }
    
    // Add difficulty announcements
    if (gameround == 8) {
        announcement += " New challenge: Decimal numbers introduced!";
    } else if (gameround == 12) {
        announcement += " New challenge: Negative numbers added!";
    } else if (gameround == 15) {
        announcement += " New challenge: Larger number ranges!";
    } else if (gameround == 20) {
        announcement += " New challenge: Mixed number types including fractions!";
    } else if (gameround == 25) {
        announcement += " Ultimate challenge: Precision decimals and complex fractions!";
    }
    
    // Add range shrinking hints for certain rounds
    if ((gameround - 1) % 4 == 0 && gameround > 1) {
        announcement += " Number range is tightening for increased difficulty.";
    }
    
    speak(announcement);
   
    // Dynamic timing based on both round difficulty and number of items
    double base_time_per_number = 10.0; // Base seconds per number to sort (more generous)
    double base_time = 40.0; // Base time regardless of count (increased)
    double min_time = 60.0; // Minimum time for any round (back to reasonable)
    
    // Round difficulty multiplier (gradually decreases as rounds progress)
    double round_multiplier = 1.2; // Start with generous time for beginners
    if (gameround >= 4) {
        round_multiplier = 1.1; // Still generous for early learning
    }
    if (gameround >= 8) {
        // Decimal numbers introduced - maintain generous time
        round_multiplier = 1.05;
    }
    if (gameround >= 12) {
        // Negative numbers - standard time
        round_multiplier = 1.0;
    }
    if (gameround >= 15) {
        // Larger ranges - slight time reduction
        round_multiplier = 0.95;
    }
    if (gameround >= 20) {
        // Mixed types - moderate challenge
        round_multiplier = 0.9;
    }
    if (gameround >= 25) {
        // Precision decimals - highest difficulty but still fair
        round_multiplier = 0.85;
    }
    
    // Apply reverse level penalty (10% less time for added challenge)
    if (reverse_level) {
        round_multiplier *= 0.9;
    }
    
    // Apply shrinking range bonus (closer numbers are harder, give slight time bonus)
    if ((gameround - 1) % 4 >= 2) { // Later rounds in each tier get small bonus
        round_multiplier *= 1.05;
    }
    
    // Calculate total time: base time + (numbers * time per number * difficulty)
    double calculated_time = base_time + (amount * base_time_per_number * round_multiplier);
    
    // Store for bonus calculation
    last_calculated_time = calculated_time < min_time ? min_time : calculated_time;
    
    // Ensure minimum time and convert to int
    round_time_left = int(last_calculated_time);

    round_timer.restart();
    tick_timer.restart();
    tick.load("clock.wav");
}

void game()
{
    while (true)
    {
        wait(5);
        
        // Run computer AI if in time race mode
        if (time_race_mode) {
            computer_ai_step();
            
            // Check if computer won the race
            if (computer_finished) {
                int race_time_seconds = race_timer.elapsed / 1000;
                double player_accuracy = total_swaps > 0 ? (double(correct_swaps) / double(total_swaps)) * 100.0 : 0.0;
                double computer_accuracy = computer_swaps > 0 ? (double(computer_correct_swaps) / double(computer_swaps)) * 100.0 : 0.0;
                
                p.play_stationary("gameover.wav", false);
                fade(gamemus);
                speak("Computer finished first! Computer wins the race!");
                wait(1000);
                
                string results = "Race results: Computer finished in " + race_time_seconds + " seconds and wins! ";
                results += "Computer made " + computer_swaps + " swaps with " + format_float(computer_accuracy, "", 0, 1) + " percent accuracy. ";
                results += "You made " + total_swaps + " swaps with " + format_float(player_accuracy, "", 0, 1) + " percent accuracy. Better luck next time!";
                
                sctext(results, 40, "dlgopn.wav", "gamevoice.wav");
                time_race_mode = false;
                mainmenu();
                return;
            }
        }
                if (key_repeating(KEY_HOME)) {
            if (nums.length() > 0) {
                numker = 0;
                play_curmove_sound();
                if (marknums[numker]) {
                    speak(format_number_for_speech(nums[numker]) + " (Marked)");
                } else {
                    speak(format_number_for_speech(nums[numker]));
                }
            } else {
                play_edge_sound();
            }
        }

        if (key_repeating(KEY_END)) {
            if (nums.length() > 0) {
                numker = int(nums.length()) - 1;
                play_curmove_sound();
                if (marknums[numker]) {
                    speak(format_number_for_speech(nums[numker]) + " (Marked)");
                } else {
                    speak(format_number_for_speech(nums[numker]));
                }
            } else {
                play_edge_sound();
            }
        }
        if (key_pressed(KEY_P)) {
            game_paused = !game_paused;
            if (game_paused) {
                gamemus.pause();
                speak("Game paused.");
            } else {
                gamemus.volume = gamemus_volume;
                gamemus.play_looped();
                speak("Game resumed.");
            }
        }
        
        if (game_paused) {
            continue;
        }

        // Timer countdown only for normal mode, not race mode
        if (!time_race_mode && tick_timer.elapsed >= 1000) {
            round_time_left--;
            tick_timer.restart();

            if (round_time_left < 21) {
                tick.play();
            }

            // Time limit only applies to normal mode, not time race
            if (!time_race_mode && round_time_left <= 0) {
                gamemus.stop();
                speak("Time's up. Game over.");
                p.play_stationary("gameover.wav", false);
                wait(1000);
                handle_game_over();
                mainmenu();
            }
        }        
        if(key_down(KEY_PAGEUP)) {
            gamemus_volume += 1;
            if(gamemus_volume > 0) gamemus_volume = 0;
            gamemus.volume = gamemus_volume;
        } else if(key_down(KEY_PAGEDOWN)) {
            gamemus_volume -= 1;
            if(gamemus_volume < -50) gamemus_volume = -50;
            gamemus.volume = gamemus_volume;
        }
        
        if (key_repeating(KEY_RIGHT)) {
            if (numker < int(nums.length()) - 1) {
                numker++;
                play_curmove_sound();
                if (marknums[numker]) {
                    speak(format_number_for_speech(nums[numker]) + " (Marked)");
                } else {
                    speak(format_number_for_speech(nums[numker]));
                }
            } else {
                play_edge_sound();
            }
        }
        
        if (key_repeating(KEY_LEFT)) {
            if (numker > 0) {
                numker--;
                play_curmove_sound();
                if (marknums[numker]) {
                    speak(format_number_for_speech(nums[numker]) + " (Marked)");
                } else {
                    speak(format_number_for_speech(nums[numker]));
                }
            } else {
                play_edge_sound();
            }
        }
        
        if (key_repeating(KEY_SPACE)) {
            marknums[numker] = !marknums[numker];
            int count = 0;
            int first = -1, second = -1;
            for (int i = 0; i < int(marknums.length()); i++) {
                if (marknums[i]) {
                    count++;
                    if (first == -1)
                        first = i;
                    else
                        second = i;
                }
            }
            if (count == 2) {
                // Check if this swap brings numbers closer to correct order
                bool is_good_swap = is_beneficial_swap(first, second);
                
                double temp = nums[first];
                nums[first] = nums[second];
                nums[second] = temp;
                
                total_swaps++;
                if (is_good_swap) {
                    correct_swaps++;
                }
                
                p.play_stationary("swap.wav", false);
                speak("Swapped");
                for (int i = 0; i < int(marknums.length()); i++)
                    marknums[i] = false;
                bool sorted = true;
                for (int i = 0; i < int(nums.length()) - 1; i++) {
                    if (reverse_level) {
                        // Check descending order for reverse levels
                        if (nums[i] < nums[i + 1]) {
                            sorted = false;
                            break;
                        }
                    } else {
                        // Check ascending order for normal levels
                        if (nums[i] > nums[i + 1]) {
                            sorted = false;
                            break;
                        }
                    }
                }
                if (sorted) {
                    if (time_race_mode) {
                        // Player finished first - they win!
                        int race_time_seconds = race_timer.elapsed / 1000;
                        double player_accuracy = total_swaps > 0 ? (double(correct_swaps) / double(total_swaps)) * 100.0 : 0.0;
                        double computer_accuracy = computer_swaps > 0 ? (double(computer_correct_swaps) / double(computer_swaps)) * 100.0 : 0.0;
                        
                        p.play_stationary("nextround.wav", false);
                        fade(gamemus);
                        speak("Congratulations! You finished first and won the race!");
                        wait(1000);
                        
                        // Announce results
                        string results = "Race results: You finished in " + race_time_seconds + " seconds and won! ";
                        results += "You made " + total_swaps + " swaps with " + format_float(player_accuracy, "", 0, 1) + " percent accuracy. ";
                        results += "Computer made " + computer_swaps + " swaps with " + format_float(computer_accuracy, "", 0, 1) + " percent accuracy but didn't finish. ";
                        results += "Congratulations on your victory!";
                        
                        ach.award("Human Supremacy", "You defeated the computer in a time race! Human intelligence prevails!");
                        
                        sctext(results, 40, "dlgopn.wav", "gamevoice.wav");
                        time_race_mode = false; // Exit race mode
                        mainmenu();
                        return;
                    } else {
                        // Normal mode completion
                        // Calculate time bonus - must complete in less than 50% of allocated time
                        int time_remaining = round_time_left;
                        int fast_completion_threshold = int(last_calculated_time * 0.5); // Must finish in under 50% of time
                        int time_bonus = 0;
                        
                        if (time_remaining > fast_completion_threshold) {
                            // Only get 2 points per second saved, and only for really fast completion
                            time_bonus = (time_remaining - fast_completion_threshold) * 2; // Much lower: 2 points per second
                            time_bonus_total += time_bonus;
                        }
                        
                        p.play_stationary("nextround.wav", false);
                        string completion_message = "Round complete!";
                        if (time_bonus > 0) {
                            completion_message += " Time bonus: " + time_bonus + " points!";
                            
                            // Single round time bonus achievements
                            if (time_bonus >= 50) {
                                ach.award("Speed Demon", "You earned 50+ time bonus points in a single round! That's some serious speed sorting.");
                            }
                            if (time_bonus >= 100) {
                                ach.award("Rocket Sorter", "100+ time bonus points in one round! You're sorting numbers faster than the speed of sound.");
                            }
                        }
                        speak(completion_message);
                        wait(1000);
                        gameround++;
                        
                        // Check for achievements
                        check_round_achievements();
                        
                        gamemus.pitch+=1;
                        gamesetup();
                        game();
                        return;
                    }
                }
            } else {
                if (marknums[numker]) {
                    p.play_stationary("marked.wav", false);
                    speak("Marked");
                } else {
                    p.play_stationary("unmarked.wav", false);
                    speak("Unmarked");
                }
            }
            wait(150);
        }        
        if (key_pressed(KEY_H)) {
            if (time_race_mode) {
                // Do nothing in time race mode
            } else if (hint_timer.elapsed < HINT_COOLDOWN) {
                int secondsLeft = (HINT_COOLDOWN - hint_timer.elapsed) / 1000;
                speak("You can't use a hint yet. Please wait " + secondsLeft + " more second" + (secondsLeft == 1 ? "" : "s") + ".");
                p.play_stationary("hinterror.wav", false);
            } else {
                int correct = 0;
                int wrong = 0;
                double[] sorted_nums;
                for (uint i = 0; i < nums.length(); i++) {
                    sorted_nums.insert_last(nums[i]);
                }
                if (reverse_level) {
                    sorted_nums.sort_descending();
                } else {
                    sorted_nums.sort_ascending();
                }

                for (uint i = 0; i < nums.length(); i++) {
                    if (nums[i] == sorted_nums[i]) {
                        correct++;
                    } else {
                        wrong++;
                    }
                }

                speak(correct + " number" + (correct == 1 ? " is" : "s are") + " in the correct spot. " + wrong + " " + (wrong == 1 ? "is" : " are") + " out of place.");
                p.play_stationary("hint.wav", false);
                
                hints_used++;
                hint_timer.restart(); 
            }
        }
        
        if (key_pressed(KEY_T)) {
            if (time_race_mode) {
                // Do nothing in time race mode
            } else {
                if (round_time_left >= 60) {
                    int minutes = round_time_left / 60;
                    int seconds = round_time_left % 60;
                    speak(minutes + " minute" + (minutes == 1 ? "" : "s") + " and " + seconds + " second" + (seconds == 1 ? "" : "s") + " remaining.");
                } else {
                    speak(round_time_left + " second" + (round_time_left == 1 ? "" : "s") + " remaining.");
                }
            }
        }

        if (key_pressed(KEY_ESCAPE)) {
            fade(gamemus);
            mainmenu();
        }
    }
}
